---
interface Props {
  class?: string;
  mono?: boolean;
  'aria-label'?: string;
}

const {
  class: className = 'h-3 w-auto text-noir-300',
  mono = false,
  'aria-label': ariaLabel = '0sec',
} = Astro.props;

const OCT = 'M4 0 H16 L20 4 V16 L16 20 H4 L0 16 V4 Z M4 5 V15 L5 16 H15 L16 15 V5 L15 4 H5 Z';
const CORE = 'M12.5 2 H17.5 L7.5 18 H2.5 Z';
// Glyph outlines for "0security", shared with the 0 repo's brand assets
// (0/assets/0-aperture-*.svg). Each glyph is placed at its x offset below.
const GLYPHS: [number, string, string?][] = [
  [28, 'M0 0 H20 V4 H0 Z M0 4 H4 V8 H0 Z M0 8 H20 V12 H0 Z M16 12 H20 V16 H16 Z M0 16 H20 V20 H0 Z'],
  [56, 'M0 0 H20 V4 H0 Z M0 0 H4 V20 H0 Z M0 8 H16 V12 H0 Z M0 16 H20 V20 H0 Z'],
  [84, 'M0 0 H20 V4 H0 Z M0 0 H4 V20 H0 Z M0 16 H20 V20 H0 Z'],
  [112, 'M0 0H4V16H16V0H20V20H0Z'],
  [140, 'M0 0H20V12H12L20 20H14.4L6.4 12H4V20H0Z M4 4V8H16V4Z', 'evenodd'],
  [168, 'M0 0H12V4H8V16H12V20H0V16H4V4H0Z'],
  [188, 'M0 0H20V4H12V20H8V4H0Z'],
  [216, 'M0 0H4V8H16V0H20V12H12V20H8V12H0Z'],
];
const coreFill = mono ? 'currentColor' : '#FD802E';
---

<svg class={className} viewBox="-2 -2 240 24" fill="none" role="img" aria-label={ariaLabel}>
  <path fill={coreFill} d={CORE} />
  <path fill="currentColor" fill-rule="evenodd" d={OCT} />
  {GLYPHS.map(([x, d, rule]) => (
    <path fill="currentColor" fill-rule={rule ?? 'nonzero'} transform={`translate(${x},0)`} d={d} />
  ))}
</svg>
