---
interface Props {
  id?: string;
}
const { id = 'install' } = Astro.props;
const commands = {
  npx: { label: 'npx', command: 'npx foxguard .', description: '' },
  pypi: { label: 'PyPI', command: 'pipx install foxguard', description: 'Python 3.9+ native wheels: Linux (glibc 2.28+), macOS, and Windows x86_64. No Rust compiler needed.' },
  curl: { label: 'curl', command: 'curl -fsSL https://foxguard.dev/install.sh | sh', description: 'Install a checksum-verified standalone binary on macOS or Linux.' },
  cargo: { label: 'cargo', command: 'cargo install foxguard', description: 'Build the CLI from source with the Rust toolchain.' },
};
const rootId = `${id}-installation`;
---

<div id={rootId} data-install-box class="rounded-xl border border-noir-800 overflow-hidden mx-auto transition-all duration-300" style="width: 440px; max-width: 100%;">
  <div role="tablist" aria-label="Installation method" class="flex border-b border-noir-800">
    {Object.entries(commands).map(([key, option]) => (
      <button
        type="button"
        role="tab"
        id={`${rootId}-${key}`}
        data-tab={key}
        aria-controls={`${rootId}-command`}
        aria-selected={key === 'npx'}
        tabindex={key === 'npx' ? 0 : -1}
        class={`flex-1 px-4 py-2 text-sm border-b-2 cursor-pointer transition-colors ${key === 'npx' ? 'text-noir-100 border-fox' : 'text-noir-600 border-transparent hover:text-noir-400'}`}
      >{option.label}</button>
    ))}
  </div>
  <div role="tabpanel" id={`${rootId}-command`} aria-labelledby={`${rootId}-npx`}>
    <button type="button" data-copy-command aria-label={`Copy command: ${commands.npx.command}`} class="w-full px-5 py-3 font-mono text-sm flex items-center justify-center cursor-pointer hover:bg-noir-900/30 active:scale-95 transition-all">
      <code data-command class="text-fox-light whitespace-nowrap overflow-hidden text-ellipsis">{commands.npx.command}</code>
    </button>
    <p data-install-description hidden={!commands.npx.description} class="px-5 pb-2 text-xs text-noir-400">{commands.npx.description}</p>
    <p data-copy-status role="status" aria-live="polite" class="sr-only"></p>
  </div>
</div>

<script define:vars={{ rootId, commands }}>
  (() => {
    const root = document.getElementById(rootId);
    if (!root) return;
    const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
    const panel = root.querySelector('[role="tabpanel"]');
    const commandEl = root.querySelector('[data-command]');
    const descriptionEl = root.querySelector('[data-install-description]');
    const copyButton = root.querySelector('[data-copy-command]');
    const statusEl = root.querySelector('[data-copy-status]');
    let currentCommand = commands.npx.command;

    function selectTab(tab, focus = false) {
      const option = commands[tab.dataset.tab];
      if (!option) return;
      currentCommand = option.command;
      commandEl.textContent = option.command;
      descriptionEl.textContent = option.description;
      descriptionEl.hidden = !option.description;
      copyButton.setAttribute('aria-label', `Copy command: ${option.command}`);
      panel.setAttribute('aria-labelledby', tab.id);
      statusEl.textContent = '';
      statusEl.className = 'sr-only';
      tabs.forEach(candidate => {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
        candidate.classList.toggle('text-noir-100', selected);
        candidate.classList.toggle('border-fox', selected);
        candidate.classList.toggle('text-noir-600', !selected);
        candidate.classList.toggle('border-transparent', !selected);
      });
      if (focus) tab.focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', event => {
        let next;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[next], true);
      });
    });

    copyButton.addEventListener('click', async () => {
      const command = currentCommand;
      try {
        await navigator.clipboard.writeText(command);
        if (currentCommand === command) {
          statusEl.className = 'sr-only';
          statusEl.textContent = 'Command copied';
        }
      } catch {
        if (currentCommand === command) {
          statusEl.className = 'px-5 pb-3 text-xs text-noir-400';
          statusEl.textContent = 'Clipboard unavailable. Select and copy the command manually.';
        }
      }
    });
  })();
</script>
