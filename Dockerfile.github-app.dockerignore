# Only Rust sources, bundled grammars, and embedded rules belong in this build context.
**
!Cargo.toml
!Cargo.lock
!build.rs
!vendor/
!vendor/**
!src/
!src/**
!rules/
!rules/**

# Keep nested development state and environment files out as well.
**/.git
**/.worktrees
**/node_modules
**/target
**/.env*